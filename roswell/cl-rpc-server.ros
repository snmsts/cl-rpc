#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn ;;init forms
  (ros:ensure-asdf)
  (let* ((script-dir (uiop:pathname-directory-pathname *load-pathname*))
         (project-root (uiop:pathname-parent-directory-pathname script-dir)))
    (push project-root asdf:*central-registry*))
  #+quicklisp(ql:quickload '(:cl-rpc) :silent t)
  )

(defpackage :ros.script.cl-rpc-server.3984816537
  (:use :cl))
(in-package :ros.script.cl-rpc-server.3984816537)

(defun main (&key (port "7654") (host "127.0.0.1") (static-dir nil) &allow-other-keys)
  (let ((port (parse-integer port)))
    (cl-rpc:start-server :port port :host host :static-dir static-dir)
    (format t "~&Server started, waiting...~%")
    (finish-output)
    (loop (sleep 60))))
;;; vim: set ft=lisp lisp:
